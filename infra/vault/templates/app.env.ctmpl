# Generated dynamically by Vault Agent at runtime - DO NOT EDIT MANUALLY
{{ with secret "tracex/data/secrets" }}
POSTGRES_USER={{ .Data.data.POSTGRES_USER }}
POSTGRES_PASSWORD={{ .Data.data.POSTGRES_PASSWORD }}
POSTGRES_DB={{ .Data.data.POSTGRES_DB }}
POSTGRES_PORT={{ .Data.data.POSTGRES_PORT }}
POSTGRES_SERVER=postgres

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER={{ .Data.data.NEO4J_USER }}
NEO4J_PASSWORD={{ .Data.data.NEO4J_PASSWORD }}

KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=tracex
KEYCLOAK_CLIENT_ID=tracex-api
KEYCLOAK_CLIENT_SECRET={{ .Data.data.KEYCLOAK_CLIENT_SECRET }}

REDIS_URL=redis://:{{ .Data.data.REDIS_PASSWORD }}@redis:6379/0
CELERY_BROKER_URL=redis://:{{ .Data.data.REDIS_PASSWORD }}@redis:6379/0
CELERY_RESULT_BACKEND=redis://:{{ .Data.data.REDIS_PASSWORD }}@redis:6379/1

SENTRY_DSN={{ .Data.data.SENTRY_DSN }}
ENVIRONMENT=production
{{ end }}
