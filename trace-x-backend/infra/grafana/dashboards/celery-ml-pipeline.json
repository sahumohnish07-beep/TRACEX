{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "ML Model Drift Early-Warning System (Primary Signal for Isolation Forest Degradation)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "PROMINENT: Primary signal for Isolation Forest drifting from its modest ~12.5% baseline. Because no real-time ground truth labels exist in production, shifts in this ratio indicate structural feature drift or entity resolution changes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 4,
            "pointSize": 6,
            "showPoints": "auto",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.08 },
              { "color": "red", "value": 0.20 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "title": "⭐ PROMINENT: Strong-Ratio Trend Line vs 12.5% Expected Baseline",
      "type": "timeseries",
      "targets": [
        {
          "expr": "tracex_ml_evidence_strength_ratio{evidence_strength=\"Strong\"}",
          "legendFormat": "Observed Strong Ratio"
        },
        {
          "expr": "0.125",
          "legendFormat": "Target Baseline (12.5% Contamination)"
        },
        {
          "expr": "0.1875",
          "legendFormat": "Upper Drift Bound (+50% dev)"
        },
        {
          "expr": "0.0625",
          "legendFormat": "Lower Drift Bound (-50% dev)"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "green", "text": "NORMAL (STABLE)" }, "1": { "color": "red", "text": "DRIFT ALERT" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "title": "Distribution Drift Alert State",
      "type": "stat",
      "targets": [
        {
          "expr": "tracex_ml_drift_alert_gauge",
          "legendFormat": "Drift Status"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 101,
      "title": "ML Evidence Strength Distribution & Volume",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 60,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "id": 3,
      "title": "Scored Connections by Evidence Strength Bucket (Strong / Moderate / Limited)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (evidence_strength) (increase(tracex_ml_predictions_total[1h]))",
          "legendFormat": "{{evidence_strength}}"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "id": 4,
      "title": "Isolation Forest Inference Latency (p50 & p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(tracex_ml_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50 (Median Latency)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracex_ml_prediction_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 102,
      "title": "Celery Asynchronous Task Pipeline (score_missing_links)",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "ops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 5,
      "title": "Celery Task Throughput & Success/Failure Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status, task_name) (rate(tracex_celery_task_runs_total[1m]))",
          "legendFormat": "{{task_name}} ({{status}})"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "fillOpacity": 70 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 6,
      "title": "score_missing_links Task Execution Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tracex_celery_task_duration_seconds_bucket{task_name=\"score_missing_links\"}[5m])) by (le))",
          "legendFormat": "score_missing_links p95 duration"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(tracex_celery_task_duration_seconds_bucket{task_name=\"score_missing_links\"}[5m])) by (le))",
          "legendFormat": "score_missing_links p50 duration"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["tracex", "ml", "celery", "drift"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["5s", "10s", "30s", "1m"] },
  "timezone": "browser",
  "title": "TRACE-X / ML Scoring & Celery Asynchronous Pipeline",
