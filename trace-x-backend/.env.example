# TRACE-X Backend Environment Variables

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracex_db
POSTGRES_PORT=5432

# Neo4j Graph DB Configuration (APOC Enabled)
NEO4J_AUTH=neo4j/tracex_graph_2026
NEO4J_PASSWORD=tracex_graph_2026

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_2026

# HashiCorp Vault Configuration
VAULT_DEV_ROOT_TOKEN_ID=tracex-dev-root-token

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_2026

# Sentry DSN Placeholder
SENTRY_DSN=https://placeholder_key@sentry.io/placeholder_project
