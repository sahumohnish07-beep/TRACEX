# =============================================================================
# TRACE-X Root Environment Variables
# DEMO VALUES - CHANGE IN PRODUCTION
#
# IMPORTANT: These default credentials and tokens are for local demonstration
# and sandbox development only. All secrets MUST be replaced with secure,
# randomly generated production values before deployment.
# =============================================================================

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_change_in_production
POSTGRES_DB=tracex_db

# Neo4j Graph Database Configuration (APOC Enabled)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tracex_graph_2026_change_in_production
NEO4J_AUTH=neo4j/tracex_graph_2026_change_in_production

# Redis & Celery Task Queue Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Keycloak IAM Configuration
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=tracex
KEYCLOAK_CLIENT_ID=tracex-api
KEYCLOAK_CLIENT_SECRET=tracex-secret-key-change_in_production
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secure_2026_change_in_production

# HashiCorp Vault Configuration
VAULT_URL=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=tracex-dev-root-token-change_in_production
VAULT_TOKEN=tracex-dev-root-token-change_in_production

# Grafana Monitoring Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_2026_change_in_production

# Observability (Sentry DSN Placeholder)
SENTRY_DSN=https://placeholder_key@sentry.io/placeholder_project

# Frontend Configuration & Law Enforcement Data Guard
# Set to 'true' to permit synthetic mock data fallback when backend is offline (for sandbox demos or e2e tests).
# In production, keep 'false' so offline backend triggers explicit "Service unavailable" error states.
VITE_ENABLE_DEMO_MODE=false


